# Kiro Cost Analyzer — Frontend Environment Variables
# Copy this file to .env.local and fill in the values from your SAM deployment outputs.

# API Gateway URL (from SAM output "ApiUrl")
# For local development with sam local start-api, use http://localhost:3000
# For deployed environment, use the API Gateway URL (e.g., https://xxx.execute-api.us-east-1.amazonaws.com/prod)
# If not set, API calls use relative paths and go through the Vite dev proxy.
VITE_API_URL=

# Cognito User Pool ID (from SAM output "UserPoolId")
# Format: {Region}_{PoolId} (e.g., sa-east-1_XXXXX)
VITE_COGNITO_USER_POOL_ID=

# Cognito User Pool Client ID (from SAM output "UserPoolClientId")
VITE_COGNITO_CLIENT_ID=
